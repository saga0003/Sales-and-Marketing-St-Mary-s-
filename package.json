{
  "name": "stmarys-marketing-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "check": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "express": "5.3.0",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
