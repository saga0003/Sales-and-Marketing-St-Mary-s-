# Copy to .env for native production, or enter values in Vercel settings.
# Never commit credentials or prefix server secrets with VITE_.
NODE_ENV=production
DEMO_MODE=false
EVALUATION_MODE=false

# Vercel REQUIRES PostgreSQL: restricted app role, private schema, verified TLS.
# Example structure: postgresql://ROLE.PROJECT:PASSWORD@POOLER:6543/postgres?sslmode=verify-full
DATABASE_URL=
# Optional PEM root CA from the database provider's official certificate page.
# With this set, TLS certificate and hostname checks stay enabled; never use
# NODE_TLS_REJECT_UNAUTHORIZED=0 or an unverified downloaded certificate.
DATABASE_SSL_CA=
DATABASE_SCHEMA=smis_marketing
# Enable for initial/pending reviewed migrations, then set false and redeploy.
AUTO_MIGRATE=false
# Native/Compose fallback only when DATABASE_URL is empty. Never hosting storage.
DATABASE_PATH=./data/production.sqlite
PORT=3001
BIND_ADDRESS=127.0.0.1
HOST_PORT=3001

# Exact HTTPS origin, no path. Development uses http://localhost:5173.
APP_ORIGIN=
COOKIE_SECURE=true
TRUST_PROXY=true
# Vercel helper opt-out: Express owns JSON and raw image parsing.
NODEJS_HELPERS=0

# Only initializes a NEW production workspace. Prefer a random 32-byte base64url
# token; give /#setup?token=VALUE privately to the manager to choose a password.
# Single use, expires after 24h. Changing these never resets an existing account.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Workspace manager
BOOTSTRAP_SETUP_TOKEN=
# Optional alternative for native/Compose; leave empty for token setup.
BOOTSTRAP_ADMIN_PASSWORD=

# Fresh 32-byte base64/hex key; preserve across deployments. Encrypts provider
# app credentials, OAuth verifiers and account credentials in the database.
CREDENTIAL_ENCRYPTION_KEY=
# Optional: managers can instead enter application credentials in Settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
# Google/Meta credentials are reused by that family's individual services.
# LinkedIn app credentials and optional service settings are saved by managers
# in Settings; see docs/CONNECTING-ACCOUNTS.md for exact callback URLs/scopes.

# Choose one private cloud media backend. The dedicated signed broker uses an
# Ed25519 PKCS8 PEM key, not a Supabase service-role key. See provider guide.
MEDIA_BROKER_URL=
MEDIA_BROKER_PRIVATE_KEY=
# Alternative: private Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Enable after provider/storage setup and checking the intended destination.
# Approved supported social posts can then be sent. No advertisements are run.
PUBLISHING_ENABLED=false
# Distinct strong random secret, sent as Authorization: Bearer VALUE by the
# publication, intelligence, and opt-in analytics-import cron endpoints.
CRON_SECRET=
