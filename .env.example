# Production configuration for `npm start` or `docker compose up`.
# Copy to .env, restrict its permissions, and fill the empty values before use.
# Do not commit .env. For the isolated demo, follow the README instead.

NODE_ENV=production
DEMO_MODE=false

# Native Node startup uses this path. Compose uses its named volume at /app/data.
# Never point production at a database previously initialized in demo mode.
DATABASE_PATH=./data/production.sqlite
PORT=3001
BIND_ADDRESS=127.0.0.1

# The complete public HTTPS origin, without a path, e.g. https://marketing.school.edu.in
APP_ORIGIN=
COOKIE_SECURE=true

# Set true only behind one trusted reverse proxy. The provided Compose service
# is bound to host loopback and expects an HTTPS reverse proxy on that host.
TRUST_PROXY=true

# Required only when initializing a NEW production database.
# No default email or password is supplied. Use a unique, strong password
# of 12–256 characters; quote values when your .env syntax requires it.
# Changing these values later does NOT reset an existing account password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Workspace manager

# Optional: change the loopback port published by Compose. The container stays
# on port 3001. The README pins the Vite demo to port 5173 explicitly.
HOST_PORT=3001
